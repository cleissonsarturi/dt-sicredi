# Copie para .env e preencha os valores antes de subir a stack:  cp .env.example .env
# O .env não é versionado: segredos e credenciais ficam só na sua máquina.

# Banco de dados (obrigatórios: usuário e senha)
POSTGRES_USER=
POSTGRES_PASSWORD=
# Opcionais: padrão "solicitacoes" e porta 5433 no host
POSTGRES_DB=
POSTGRES_PORT=

# Segredo de assinatura do JWT (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=

# Usuário criado na primeira inicialização (quando a base não tem nenhum usuário).
# São as credenciais de acesso à aplicação. Senha com no mínimo 8 caracteres.
USUARIO_INICIAL_NOME=
USUARIO_INICIAL_EMAIL=
USUARIO_INICIAL_SENHA=

# Opcional: URL do sistema externo notificado na aprovação (vazio = modo simulado)
INTEGRACAO_URL=
