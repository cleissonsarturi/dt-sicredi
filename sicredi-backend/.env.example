# Copie para .env e preencha os valores (ver tabela de variáveis no README da raiz).
NODE_ENV=
PORT=
CORS_ORIGIN=

# Mesmos valores de POSTGRES_* do .env da raiz (banco do docker compose)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Executa as migrations pendentes ao iniciar a aplicação
DB_MIGRATIONS_RUN=

# Integração com sistema externo (acionada quando uma solicitação é aprovada).
# Vazio = modo simulado (o envio é apenas registrado em log).
INTEGRACAO_URL=
INTEGRACAO_TIMEOUT_MS=
INTEGRACAO_INTERVALO_MS=
INTEGRACAO_MAX_TENTATIVAS=

# Autenticação (JWT): segredo com pelo menos 32 caracteres (ex.: openssl rand -base64 48).
JWT_SECRET=
JWT_EXPIRACAO_SEGUNDOS=
# Usuário criado na inicialização se a base não tiver nenhum usuário.
USUARIO_INICIAL_NOME=
USUARIO_INICIAL_EMAIL=
USUARIO_INICIAL_SENHA=
